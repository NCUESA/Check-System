# 手動部署用的變數清單。複製成 /srv/check/.env 或 /srv/check_stage/.env。
#
# docker-compose.yml 裡所有設定都是 ${VAR} 形式，compose 會依序從
# 「執行 compose 的 shell 環境變數」→「這個檔案」取值。
# 走 CI/CD 的話環境變數由 runner 注入，伺服器上不需要這個檔案。
#
# 不論哪一種，設定都不會進 image。

# ---- compose 用 ----
# 正式與測試跑的是「同一個 image」，只有下面這幾個名字和後面的設定不一樣
APP_IMAGE=image.ncuesa.org.tw/check-system:latest
# compose 專案名稱：正式 check、測試 check_stage
COMPOSE_PROJECT=check
# container 名稱。nginx 是用這個名字連過來的（fastcgi_pass <這個名字>:9000），
# 改了這裡就要一起改 /srv/nginx/conf.d/ 底下對應的設定檔
APP_CONTAINER=check

# ---- Laravel 基本 ----
APP_NAME="學生會值勤系統"
APP_ENV=production
# 用 docker run --rm <image> php artisan key:generate --show 產生後貼上
APP_KEY=
APP_DEBUG=false
# 對外的實際網址，要帶埠號或網域。登出跳轉、寄信都靠它
APP_URL=https://check.ncuesa.org.tw
APP_TIMEZONE=Asia/Taipei
APP_LOCALE=zh_TW

# 啟動時自動跑 migration。預設關閉，第一次部署再手動跑
AUTO_MIGRATE=false

# ---- 資料庫 ----
# DB_HOST 是 /srv/mysql 裡的服務名稱，不是 IP
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sa_duty
DB_USERNAME=check
DB_PASSWORD=CHANGE_ME_PROD

# ---- Session / 快取 ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# https 才開，否則登入會失敗
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---- Keycloak SSO ----
KEYCLOAK_CLIENT_ID=check-system
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=https://check.ncuesa.org.tw/login/keycloak/callback
KEYCLOAK_BASE_URL=https://portal.ncuesa.org.tw
KEYCLOAK_REALM=NCUESA

# ---- 打卡 ----
# 嗶卡要驗證來源 IP 所屬地點
DUTY_CARD_CHECK_LOCATION=true
# 手機端也驗證。同一天在兩個地點值勤時，沒有這個就無法判斷要簽哪一邊
DUTY_PHONE_CHECK_LOCATION=true
DUTY_CHECK_INTERVAL_MINUTES=2

# ---- 反向代理 ----
# 留空代表信任所有代理。要收緊就填 IT 給你的代理網段
TRUSTED_PROXIES=

# ---- 前端 ----
VITE_TINYMCE_API_KEY=
