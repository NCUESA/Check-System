# 複製成 /srv/check/.env（正式）或 /srv/check_stage/.env（測試）後修改。
# 這個檔案不會進 image，只在伺服器上存在。

# ---- compose 用 ----
APP_IMAGE=image.ncuesa.org.tw/check-system:latest
NGINX_IMAGE=image.ncuesa.org.tw/check-system-nginx:latest
APP_CONTAINER=check-app
WEB_CONTAINER=check-web
# 主機要開哪個埠。正式 8000、測試 8001，兩個不能一樣
APP_PORT=8000

# ---- Laravel 基本 ----
APP_NAME="學生會值勤系統"
APP_ENV=production
# 用 docker run --rm <image> php artisan key:generate --show 產生後貼上
APP_KEY=
APP_DEBUG=false
# 對外的實際網址，要帶埠號或網域。登出跳轉、寄信都靠它
APP_URL=https://check.ncuesa.org.tw
APP_TIMEZONE=Asia/Taipei
APP_LOCALE=zh_TW

# 啟動時自動跑 migration。預設關閉，第一次部署再手動跑
AUTO_MIGRATE=false

# ---- 資料庫 ----
# DB_HOST 是 /srv/mysql 裡的服務名稱，不是 IP
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sa_duty
DB_USERNAME=check
DB_PASSWORD=CHANGE_ME_PROD

# ---- Session / 快取 ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# https 才開，否則登入會失敗
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---- Keycloak SSO ----
KEYCLOAK_CLIENT_ID=check-system
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=https://check.ncuesa.org.tw/login/keycloak/callback
KEYCLOAK_BASE_URL=https://portal.ncuesa.org.tw
KEYCLOAK_REALM=NCUESA

# ---- 打卡 ----
# 嗶卡要驗證來源 IP 所屬地點
DUTY_CARD_CHECK_LOCATION=true
# 手機端先不驗證，之後要開再改成 true
DUTY_PHONE_CHECK_LOCATION=false
DUTY_CHECK_INTERVAL_MINUTES=2

# ---- 反向代理 ----
# 留空代表信任所有代理。要收緊就填 IT 給你的代理網段
TRUSTED_PROXIES=

# ---- 前端 ----
VITE_TINYMCE_API_KEY=
