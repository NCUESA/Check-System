# 手動部署用。複製到 /srv/check_stage/.env（測試環境）。
#
# 走 CI/CD 的話不需要這個檔案——設定由 runner 當環境變數注入，
# compose 會優先採用環境變數。這個檔案只是手動部署時的替代來源。
#
# docker-compose.yml 與正式環境完全一樣，差別都在這裡。

# ---- compose 用 ----
# 跟正式環境用「同一個 image」，差別只在這個檔案裡的設定
APP_IMAGE=image.ncuesa.org.tw/check-system:latest
# compose 專案名稱，決定 docker 怎麼把這組容器歸類
COMPOSE_PROJECT=check_stage
# container 名稱。nginx 是用這個名字連過來的（fastcgi_pass check_stage:9000），
# 改了這裡就要一起改 /srv/nginx/conf.d/check_stage.conf
APP_CONTAINER=check_stage

# ---- Laravel 基本 ----
APP_NAME="學生會值勤系統"
APP_ENV=staging
# 用 docker run --rm <image> php artisan key:generate --show 產生後貼上
APP_KEY=
APP_DEBUG=true
# 對外的實際網址，要帶埠號或網域。登出跳轉、寄信都靠它
APP_URL=https://stage.check.ncuesa.org.tw
APP_TIMEZONE=Asia/Taipei
APP_LOCALE=zh_TW

# 啟動時自動跑 migration。預設關閉，第一次部署再手動跑
AUTO_MIGRATE=false

# ---- 資料庫 ----
# DB_HOST 是 /srv/mysql 裡的服務名稱，不是 IP
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sa_duty_stage
DB_USERNAME=check_stage
DB_PASSWORD=CHANGE_ME_STAGE

# ---- Session / 快取 ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# https 才開，否則登入會失敗
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# ---- Keycloak SSO ----
KEYCLOAK_CLIENT_ID=check-system
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=https://stage.check.ncuesa.org.tw/login/keycloak/callback
KEYCLOAK_BASE_URL=https://portal.ncuesa.org.tw
KEYCLOAK_REALM=NCUESA

# ---- 打卡 ----
# 嗶卡要驗證來源 IP 所屬地點
DUTY_CARD_CHECK_LOCATION=true
# 手機端也驗證。同一天在兩個地點值勤時，沒有這個就無法判斷要簽哪一邊
DUTY_PHONE_CHECK_LOCATION=true
DUTY_CHECK_INTERVAL_MINUTES=2

# ---- 反向代理 ----
# 留空代表信任所有代理。要收緊就填 IT 給你的代理網段
TRUSTED_PROXIES=

# ---- 前端 ----
VITE_TINYMCE_API_KEY=
